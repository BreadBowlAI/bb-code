BB_QKV_API_URL=
BB_QKV_API_KEY=

# This repository .env is for development smoke tests. Run `bb qkv configure`
# to save credentials for installed CLI, hook, and MCP processes.
# Required only by `pnpm test:qkv-live`; use an existing disposable QKV index.
BB_QKV_TEST_INDEX_ID=
BB_QKV_TEST_TIMEOUT_MS=10000
