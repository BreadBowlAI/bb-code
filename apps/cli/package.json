{
  "name": "@breadbowl/bb-code",
  "version": "0.1.0",
  "description": "The continuity layer for software engineering agents",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "bb": "./dist/launcher.js"
  },
  "main": "./dist/launcher.js",
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup src/launcher.ts src/cli.ts --format esm --platform node --sourcemap --clean && node scripts/copy-plugins.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@breadbowl/bb-core": "workspace:*",
    "@breadbowl/bb-qkv-client": "workspace:*",
    "@inquirer/prompts": "^7.8.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
